{
  "name": "starlite-dsh-workspace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "BSD-2-Clause",
  "author": "StarCried",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarCried/starlite-dsh.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "lint": "oxlint --deny-warnings packages tools apps/desktop/src",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --dir packages/protocol build && vitest run && pnpm test:dependency-audit",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:core": "pnpm lint && pnpm typecheck && pnpm test && pnpm --dir packages/dsh-plugin build && pnpm --dir tools/mock-source build",
    "desktop:dev": "pnpm --dir apps/desktop tauri dev",
    "desktop:build": "pnpm --dir apps/desktop tauri build",
    "pack:plugin": "pnpm --dir packages/dsh-plugin run pack:check",
    "stage:plugin": "node tools/stage-plugin-desktop.mjs",
    "serve:character": "node tools/local-character-server.mjs",
    "pack:portable": "node tools/pack-portable.mjs",
    "sync:runtime": "node tools/sync-model-runtime.mjs",
    "check:dsh-contract": "node tools/check-dsh-contract.mjs",
    "check:release": "node tools/check-release.mjs",
    "release:metadata": "node tools/generate-release-metadata.mjs",
    "check:dependencies": "node tools/check-dependency-audit.mjs",
    "test:dependency-audit": "node --test tools/check-dependency-audit.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.11.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
