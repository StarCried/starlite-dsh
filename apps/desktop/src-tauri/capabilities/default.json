{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "description": "Narrow desktop permissions for the pet and settings windows",
  "windows": ["main", "settings"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-position",
    "deep-link:default",
    "dialog:allow-open"
  ]
}
