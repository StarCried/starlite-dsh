{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarLite for DSH",
  "version": "0.1.0-alpha.0",
  "identifier": "com.starcried.dsh-inochi2d-pet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StarLite for DSH",
        "width": 320,
        "height": 480,
        "minWidth": 214,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "StarLite for DSH 设置",
        "url": "index.html?view=settings",
        "width": 760,
        "height": 720,
        "minWidth": 620,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: http://127.0.0.1:*; worker-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/models/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "StarCried",
    "copyright": "Copyright © 2026 StarCried",
    "shortDescription": "StarLite for DSH: lightweight VRM desktop companion",
    "longDescription": "A lightweight local StarLite character for DeepSeek Harness on Windows: official Desktop, native CLI/Web, or WSL2.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dsh-inochi2d-pet"]
      }
    }
  }
}
